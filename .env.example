# Copy to .env, or just run `npm start` and use the setup wizard. Every line is optional.
# CABINSCOUT_PORT=3000
# GEMINI_API_KEY=          # FREE AI advisor + photo reading (aistudio.google.com/apikey)
# ANTHROPIC_API_KEY=       # Claude instead of Gemini (paid, console.anthropic.com)
# TELEGRAM_BOT_TOKEN=      # Scout Log bot (create with @BotFather)
# GOOGLE_MAPS_API_KEY=     # better place search + elevation
# REGRID_TOKEN=            # parcel lines outside Massachusetts (regrid.com)
