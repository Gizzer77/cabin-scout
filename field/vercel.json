{
  "cleanUrls": true,
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }, { "key": "Service-Worker-Allowed", "value": "/" }] },
    { "source": "/(.*)", "headers": [{ "key": "Permissions-Policy", "value": "geolocation=(self), accelerometer=(self), magnetometer=(self), gyroscope=(self)" }] }
  ]
}
